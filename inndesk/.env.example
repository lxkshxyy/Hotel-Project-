# Address of the StayEasy customer website that partner listings publish to.
VITE_MAIN_SITE_URL=http://localhost:5173

# Leave both empty to run in local demo mode (data stays on this computer).
# For the live site, use the SAME Supabase project as StayEasy, after running
# StayEasy's supabase/schema.sql (it includes the "Partner panel" section).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional: MapTiler key for a nicer street map on the Location step (https://cloud.maptiler.com, free plan for testing).
# Leave empty to use free OpenStreetMap tiles.
VITE_MAPTILER_KEY=
