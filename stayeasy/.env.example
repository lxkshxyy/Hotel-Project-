# Copy to .env.local for your computer, or add these in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase keys empty to run in demo mode (sample hotels, bookings saved in the browser).

# Supabase (Project Settings → API). The anon key is public by design; never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay public key id (rzp_live_… or rzp_test_…). Empty = "Pay now" shows "Coming soon".
VITE_RAZORPAY_KEY_ID=

# Contact and company details shown on the site, vouchers and legal pages. Empty = hidden.
VITE_SUPPORT_PHONE=
VITE_SUPPORT_EMAIL=
VITE_WHATSAPP=
VITE_LEGAL_NAME=
VITE_LEGAL_ADDRESS=
VITE_COMPANY_GSTIN=

# Other panels' web addresses (hotel owners: InnDesk; travel agents: TripDesk).
VITE_PARTNER_PANEL_URL=
VITE_AGENT_PANEL_URL=

# Optional switches: on / off. Defaults: on in demo mode, off on the live site.
VITE_ENABLE_BUSINESS=
VITE_STAY_PROTECT=

# Used at build time for sitemap.xml (e.g. https://www.yourdomain.com)
SITE_URL=
