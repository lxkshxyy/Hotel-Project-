# Hostinger (LiteSpeed/Apache) rules for this site. Upload together with the other files in public_html.

Options -Indexes
DirectoryIndex index.html
# /hotels is both a page and the hotel-photos folder: never add a slash or list folders.
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Always use the secure https:// address (sign-in and payments need it).
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Real files are served as they are (folders are not: /hotels is a page, not the photo folder).
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # A missing file with an extension (an old /assets/… file) is a real 404, not the app page.
  RewriteCond %{REQUEST_URI} \.[A-Za-z0-9]{2,5}$
  RewriteRule ^ - [R=404,L]

  # Every page address (/hotels, /hotel/…, /app/…) opens the app, which shows the right page.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/javascript application/javascript application/json application/manifest+json image/svg+xml application/xml
</IfModule>

<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType image/webp .webp
</IfModule>

<IfModule mod_headers.c>
  # Files in /assets have a fingerprint in their name, so browsers can keep them for a year.
  <FilesMatch "\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(webp|png|jpg|jpeg|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # The page itself, the offline worker and the app manifest must always be checked for updates.
  <FilesMatch "^(index\.html|sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Security headers.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
  # Which outside services the pages may use. If you add a new one (another map provider, analytics,
  # a custom Supabase domain), add its address here or the browser will block it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://*.razorpay.com https://fonts.googleapis.com https://fonts.gstatic.com https://photon.komoot.io https://nominatim.openstreetmap.org https://api.maptiler.com; frame-src 'self' https://*.razorpay.com; worker-src 'self' blob:; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
</IfModule>
